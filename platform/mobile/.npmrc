legacy-peer-deps=true

# The `shared/` workspace folder has no package.json of its own (it's
# consumed only via TS path-mapping from apps/client and apps/restaurant),
# so it never declares its own react/expo/etc devDependencies. Under pnpm's
# default isolated node_modules those packages are only visible where
# actually declared, which leaves `shared/*.tsx` unable to resolve `react`
# and friends. shamefully-hoist restores npm-style flat resolution so the
# already-declared app-level dependencies are reachable from `shared/` too.
shamefully-hoist=true
