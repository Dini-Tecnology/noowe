{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/shared/*": ["../../shared/*"],
      "@okinawa/shared/*": ["../../shared/*"]
    }
  },
  "files": [
    "src/App.tsx",
    "app/auth/callback.tsx",
    "app/auth/reset-password.tsx",
    "app/t/[code].tsx",
    "../../shared/types/expo-modules.d.ts"
  ],
  "exclude": ["node_modules"]
}
