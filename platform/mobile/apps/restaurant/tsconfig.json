{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/shared/*": ["../../shared/*"],
      "@okinawa/shared/*": ["../../shared/*"],
      "react": ["./node_modules/@types/react"],
      "react-native": ["./node_modules/react-native/types"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../../shared/**/*"],
  "exclude": ["node_modules"]
}
