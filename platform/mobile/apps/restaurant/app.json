{
  "expo": {
    "name": "Noowe Restaurant",
    "slug": "okinawa-restaurant",
    "newArchEnabled": true,
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "okinawa-restaurant",
    "splash": {
      "image": "./assets/logo-completa-restaurant.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "15.1",
      "bundleIdentifier": "com.noowe.restaurant",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:noowebr.com",
        "applinks:*.noowebr.com"
      ],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "CFBundleDisplayName": "Noowe Restaurant",
        "CFBundleName": "Noowe Restaurant",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Permite escanear QR codes nas estações de trabalho",
        "NSLocationWhenInUseUsageDescription": "Permite identificar a filial do restaurante",
        "NSPhotoLibraryUsageDescription": "Permite upload de fotos de pratos e cardápio",
        "NSFaceIDUsageDescription": "Permite login rápido com biometria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.noowe.restaurant",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "noowebr.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite login rápido com biometria"
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite escanear QR codes nas estações de trabalho"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite identificar a filial do restaurante e modo food truck"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o NOOWE acesse suas fotos para definir a imagem do restaurante."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A855F7"
        }
      ],
      "@react-native-firebase/app"
    ],
    "extra": {
      "eas": {
        "projectId": "744e4a02-0a92-4dfb-bf5a-ea0e68169afe"
      }
    },
    "owner": "dini-technologies"
  }
}
