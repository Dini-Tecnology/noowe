# Supabase Edge Functions secrets
#
# Local:
#   cp platform/supabase/.env.example platform/supabase/.env
#   supabase functions serve --env-file platform/supabase/.env
#
# Remote:
#   cd platform/supabase
#   supabase secrets set --env-file .env --project-ref eplivpvqemowmbivhfpx

SUPABASE_URL=https://eplivpvqemowmbivhfpx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Cloud Messaging HTTP v1 (Android native device tokens).
# Keep the service-account JSON on one line when using `supabase secrets set`.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Resend > API Keys
RESEND_API_KEY=

# The sender domain must be verified in Resend for reliable delivery.
RESEND_FROM_EMAIL="NOOWE <notification@noowebr.com>"

# Public logo URLs for transactional emails (optional).
# If unset, the edge function embeds the official logo in the HTML (recommended).
# After deploying site/public/email/* to noowebr.com, you may set:
# EMAIL_LOGO_URL_RESTAURANT=https://noowebr.com/email/logo-restaurant.png
# EMAIL_LOGO_URL_CLIENT=https://noowebr.com/email/logo-client.png
# Optional override for all apps:
# EMAIL_LOGO_URL=

# Optional comma-separated overrides.
ALLOWED_ORIGINS=https://noowebr.com,https://www.noowebr.com
AUTH_REDIRECT_ALLOW_LIST=okinawa-restaurant://auth/callback,noowe://auth/callback,https://noowebr.com/auth/callback,https://www.noowebr.com/auth/callback

# Pagamentos (Edge Functions payments-*). Também devem existir em Edge Functions > Secrets.
# O ambiente é escolhido pela chave Asaas da subconta de cada restaurante
# (_hmlg_ = sandbox, _prod_ = produção); as chaves das subcontas ficam só no cofre.
ASAAS_SANDBOX_API_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_PRODUCTION_API_BASE_URL=https://api.asaas.com/v3
# Chave da conta raiz da NOOWE: payments-account cria subcontas; billing-charge e billing-nfse cobram a assinatura e emitem a nota.
ASAAS_ROOT_API_KEY=
# Token do webhook da conta raiz (billing-webhook): o mesmo valor configurado no painel do Asaas.
BILLING_WEBHOOK_TOKEN=
# Recebe os avisos do Asaas sobre falha no webhook de cada subconta.
NOOWE_WEBHOOK_ALERT_EMAIL=
# Wallet da NOOWE que recebe a taxa de plataforma no split.
NOOWE_ASAAS_WALLET_ID=
# Para onde o checkout do cartão devolve o cliente.
PAYMENT_RETURN_URL=
